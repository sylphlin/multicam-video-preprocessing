# Google Cloud Vertex AI & Cloud Storage Configuration (100% ADC)
# Run `gcloud auth application-default login` and `./setup.sh` to auto-provision:
#   gcloud storage buckets create gs://multicam-video-your-gcp-project-id --location=us-central1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GCP_REGION=us-central1
GCS_BUCKET=multicam-video-your-gcp-project-id
